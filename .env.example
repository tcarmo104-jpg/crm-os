# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: "anon" o "publishable". Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SOLO SERVIDOR (nunca con prefijo NEXT_PUBLIC_, nunca en el navegador) ---
# Clave secreta "service_role" / "secret". Solo la usan los procesos de fondo.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto para autorizar las llamadas al endpoint de eventos (genera uno largo y aleatorio).
CRON_SECRET=

# --- URL pública de la app (para enlaces de invitación). En local: http://localhost:3000 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Meta) — SOLO SERVIDOR ---
# App Secret de tu app de Meta (Configuración de la app → Básica). Firma cada webhook; sin él no se acepta nada.
META_APP_SECRET=
# Texto que TÚ inventas (largo y aleatorio) y pegas en Meta al configurar el webhook.
META_VERIFY_TOKEN=
# Opcional: versión de la API de Meta (por defecto v24.0).
# META_GRAPH_VERSION=v24.0

